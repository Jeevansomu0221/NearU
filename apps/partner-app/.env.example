# Production / EAS builds. For local Expo, use .env.local with your LAN IP instead:
# EXPO_PUBLIC_API_URL=http://10.x.x.x:5000
# To geocode against the VPS (Google Places) from Expo: EXPO_PUBLIC_USE_PRODUCTION_API=1
EXPO_PUBLIC_API_URL=https://api.vyaha.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional JSON map of Firebase Console test phones → OTP codes, e.g. {"9999900000":"123456"}
# EXPO_PUBLIC_FIREBASE_TEST_PHONES={"9999900000":"123456"}
# Optional soft backend test logins (defaults include 1010101010/000000 and 1234567890/123456)
# EXPO_PUBLIC_TEST_LOGIN_CREDENTIALS={"1234567890":"123456"}
