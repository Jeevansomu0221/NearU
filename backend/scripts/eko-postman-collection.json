{
  "info": {
    "_postman_id": "vyaha-eko-live-001",
    "name": "Vyaha Eko Live",
    "description": "Eko ICICI live APIs for Vyaha.\n\n1. Open this collection → Variables tab\n2. Paste eko_developer_key and eko_access_key from Eko email\n3. Run \"Settlement balance inquiry\"\n\nAuth headers (secret-key + timestamp) are generated automatically before each request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "eko_base_url",
      "value": "https://api.eko.in:25002/ekoicici"
    },
    {
      "key": "eko_developer_key",
      "value": ""
    },
    {
      "key": "eko_access_key",
      "value": ""
    },
    {
      "key": "eko_initiator_id",
      "value": "6300500275"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const accessKey = pm.collectionVariables.get('eko_access_key');",
          "const developerKey = pm.collectionVariables.get('eko_developer_key');",
          "if (!accessKey || !developerKey) {",
          "  throw new Error('Set eko_developer_key and eko_access_key in collection Variables');",
          "}",
          "const timestamp = Date.now().toString();",
          "const encodedKey = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(accessKey));",
          "const hash = CryptoJS.HmacSHA256(timestamp, encodedKey);",
          "const secretKey = CryptoJS.enc.Base64.stringify(hash);",
          "pm.request.headers.upsert({ key: 'developer_key', value: developerKey });",
          "pm.request.headers.upsert({ key: 'secret-key-timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'secret-key', value: secretKey });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "// Do NOT set Content-Type on GET — Eko returns HTTP 415 if you do.",
          "pm.request.headers.remove('Content-Type');",
          "pm.request.headers.remove('content-type');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Settlement balance inquiry",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{eko_base_url}}/v1/customers/mobile_number:{{eko_initiator_id}}/balance?initiator_id={{eko_initiator_id}}",
        "description": "Read-only. Expected SUCCESS with balance (may be 0.0)."
      },
      "response": []
    }
  ]
}
