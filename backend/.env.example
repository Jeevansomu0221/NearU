NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.vyaha.com
CORS_ORIGINS=https://your-admin-domain.example,https://www.vyaha.com,https://vyaha.com,http://localhost:5173,http://localhost:5174,http://localhost:5175
REQUEST_BODY_LIMIT=5mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRY=15m
REFRESH_JWT_EXPIRY=7d

ADMIN_PANEL_PHONE=
ADMIN_PANEL_PASSWORD=

OTP_PROVIDER=2factor
OTP_FIREBASE_FALLBACK=false
OTP_DEBUG=true

# 2Factor OTP SMS only (never transactional R1 / never VOICE path)
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=VYAHA
TWOFACTOR_TEMPLATE_NAME=Login-otp-vyaha
TWOFACTOR_TEMPLATE_ID=1207178307660856305
TWOFACTOR_DLT_ENTITY_ID=1201178135264753827
TWOFACTOR_OTP_CHANNEL=sms
# Do NOT set TWOFACTOR_VOICE_API_KEY — this backend never uses voice OTP.

FIREBASE_PROJECT_ID=vyaha-a24a7
FIREBASE_SERVICE_ACCOUNT_JSON=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional fallback when Razorpay QR/links are unavailable — customer pays platform VPA directly
PLATFORM_UPI_VPA=
PLATFORM_UPI_PAYEE_NAME=Vyaha Technologies
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nearu-app

TEST_LOGIN_PHONE=1010101010
TEST_LOGIN_OTP=000000
# Optional extra soft test logins (JSON phone → OTP). Defaults already include 1010101010/000000 and 1234567890/123456.
# TEST_LOGIN_CREDENTIALS={"1234567890":"123456","9999900000":"123456"}
# Keep true so multiple devices can stay logged in on the same account (logout does not kick other devices).
ALLOW_MULTI_DEVICE_SESSIONS=true

GOOGLE_MAPS_API_KEY=
DELIVERY_RADIUS_KM=8
DELIVERY_LOCATION_FRESHNESS_MINUTES=10

# Decentro digital KYC (delivery riders).
# IMPORTANT: client_id/secret must match the base URL environment.
# Current VyahaTechnologies_* keys authenticate on STAGING only.
DECENTRO_BASE_URL=https://in.staging.decentro.tech
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_KYC_MODULE_SECRET=
DECENTRO_PAYMENTS_MODULE_SECRET=
DECENTRO_CORE_BANKING_MODULE_SECRET=
DECENTRO_PROVIDER_SECRET=
DECENTRO_CONSUMER_URN=
DECENTRO_BANK_VALIDATION_TYPE=penniless
# Set true for local UI testing without live Decentro calls (Aadhaar OTP = 111111)
DECENTRO_MOCK=false
